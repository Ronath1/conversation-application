# Copy to .env and fill in. .env is gitignored.
# Seeds data/config.json on first boot only; after that the key lives in
# data/config.json and is swapped through the settings endpoint.
GEMINI_API_KEY=
PORT=3000

# Optional: only needed if you use the Claude provider.
ANTHROPIC_API_KEY=

# Set this anywhere reachable from the internet. Any user name works at the
# browser prompt; only the password is checked. Leave it empty for local use.
APP_PASSWORD=

# Postgres connection string. Leave empty to store everything in data/ instead.
DATABASE_URL=

# Clerk. Create an application at clerk.com, then copy both from API Keys.
# The publishable key is safe in the browser; the secret key never is.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 64 hex characters, used to encrypt stored API keys. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it makes every stored key unreadable.
ENCRYPTION_KEY=

# Optional provider keys. Only used when sign-in is switched off, i.e. locally.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
