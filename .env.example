# Copy to .env and fill in. .env is gitignored.
# Seeds data/config.json on first boot only; after that the key lives in
# data/config.json and is swapped through the settings endpoint.
GEMINI_API_KEY=
PORT=3000

# Optional: only needed if you use the Claude provider.
ANTHROPIC_API_KEY=

# Set this anywhere reachable from the internet. Any user name works at the
# browser prompt; only the password is checked. Leave it empty for local use.
APP_PASSWORD=

# Postgres connection string. Leave empty to store everything in data/ instead.
DATABASE_URL=
